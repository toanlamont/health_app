# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# --- Machine-specific, generated by the tooling on each checkout ---
# local.properties holds absolute SDK paths, so committing it breaks the build
# for anyone whose Flutter and Android SDKs live somewhere else.
/android/local.properties
/android/.gradle/
/ios/Flutter/Generated.xcconfig
/ios/Flutter/flutter_export_environment.sh
/ios/Flutter/.last_build_id
/ios/Pods/
/ios/.symlinks/
/ios/Runner/GeneratedPluginRegistrant.*

# --- Signing ---
# A keystore and its passwords let anyone publish an update that phones will
# accept as genuine. They never go in the repository.
*.jks
*.keystore
/android/key.properties

# --- Build output ---
# Covered by /build/ above, but a build run from elsewhere can land these here.
*.apk
*.aab
*.aar
